    "actSat=set()\n",
    "activity=input('enter an activity from last Saturday(\"Done\" to stop): ')\n",
    "while activity != \"Done\":\n",
    "    actSat.add(activity)\n",
    "    activity=input('enter an activity from last Saturday(\"Done\" to stop):')\n",
    "    \n",
    "actSun=set()\n",
    "activity=input('enter an activity from last Sunday(\"Done\" to stop): ')\n",
    "while activity != \"Done\": \n",
    "    actSun.add(activity) \n",
    "    activity=input('enter an activity from last Sunday(\"Done\" to stop): ')\n",
    "print('Saturday activities:', actSat)\n",
    "print('Sunday activity:', actSun)\n",
    "\n",
    "print('Activities  done on both days:', actSat.intersection(actSun))\n",
    "print('Activities done on at leas one of the days:', actSat.union(actSun))"
   ]
