    "class Calculator: \n",
    "    def __init__(self):\n",
    "        self.prev_result=0\n",
    "        self.total_calculations=0 \n",
    "    def add(self,a, b):\n",
    "        self.prev_result=a + b\n",
    "        self.total_calculations= self.total_calculations + 1\n",
    "        return self.prev_result\n",
    "    def substract(self, a, b):\n",
    "        self.prev_result= a-b \n",
    "        self.total_calculations=self.total_calculations + 1\n",
    "        return self.prev_result\n",
    "    def multiply(self, a, b): \n",
    "        self.prev_result= a*b\n",
    "        self.total_calculations=self.total_calculations+1\n",
    "    def divide(self, a, b):\n",
    "        self.prev_result=a/b\n",
    "        self.total_calculations=self.total_calculations+1\n",
    "        return self.prev_result\n",
    "    def power(self, a, b):\n",
    "        self.prev_result=a**b\n",
    "        self.total_calculations=self.total_calculations+1 \n",
    "        return self.prev_result\n",
    "    def info(self):\n",
    "        print('Previous result:', self.prev_result)\n",
    "        print('Total calculations:', self.total_calculations)\n",
    "calc=Calculator()\n",
    "print(calc.add(5, 5))\n",
    "print(calc.substract(5, 5))\n",
    "print(calc.multiply(5, 5))\n",
    "print(calc.divide(5, 5))\n",
    "print(calc.power(5, 5))\n",
    "calc.info()"
