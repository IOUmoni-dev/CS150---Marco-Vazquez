    "def triangle_solve(leg1,leg2):\n",
    "    hypotenuse=(leg1**2+leg2**2)**0.5\n",
    "    perimeter=leg1+leg2+hypotenuse\n",
    "    area=(1/2)*leg1*leg2\n",
    "    return(hypotenuse, perimeter, area) \n",
    "print(triangle_solve(3,4))"
   ]
